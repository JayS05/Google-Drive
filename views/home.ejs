<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Cloud Drive</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdn.jsdelivr.net/npm/flowbite@4.0.1/dist/flowbite.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet"/>
</head>

<body class="bg-gray-50 dark:bg-gray-900 min-h-screen text-gray-900 dark:text-gray-100">

  <main class="p-8">
    <!-- Header -->
    <div class="flex justify-between items-center mb-8">
      <h1 class="text-2xl font-bold flex items-center gap-2">
        <i class="ri-folder-cloud-fill text-blue-500 text-3xl"></i> 
        My Drive
      </h1>

      <div class="flex items-center gap-4">
        <span class="text-sm text-gray-600 dark:text-gray-400">
          Welcome, <strong><%= username %></strong>
        </span>
        
        <!-- Logout Button -->
        <form action="/logout" method="POST" style="display: inline;">
          <button type="submit"
                  class="bg-red-500 hover:bg-red-600 text-white font-medium py-2 px-5 rounded-lg flex items-center gap-2 transition-all">
            <i class="ri-logout-box-r-line"></i>
            Logout
          </button>
        </form>

        <button 
          onclick="showModal()"
          class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-6 rounded-lg shadow-md transition-all flex items-center gap-2">
          <i class="ri-add-line"></i> Upload File
        </button>
      </div>
    </div>

    <!-- Welcome -->
    <h2 class="text-xl mb-6">Welcome, <%= username %> 👋</h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
      <% if (files && files.length > 0) { %>
        <% files.forEach(file => { %>
          <div class="bg-white dark:bg-gray-800 p-4 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 hover:shadow-md transition-shadow group relative">
            <div class="flex flex-col items-center py-4">
               <i class="ri-file-text-line text-5xl text-blue-400 mb-3"></i>
               <p class="text-sm font-medium truncate w-full text-center px-2" title="<%= file.originalname %>">
                 <%= file.originalname %>
               </p>
               <p class="text-xs text-gray-500 mt-1">
                 <%= (file.size / (1024*1024)).toFixed(2) %> MB
               </p>
            </div>

            <div class="flex justify-center gap-6 mt-4 border-t pt-3 border-gray-100 dark:border-gray-700">
              <!-- Download -->
              <a href="/download/<%= file._id %>" 
                 class="text-gray-500 hover:text-blue-600 transition-colors flex flex-col items-center text-xs">
                <i class="ri-download-2-line text-2xl"></i>
                <span>Download</span>
              </a>

              <!-- Delete -->
              <form action="/delete/<%= file._id %>" method="POST" style="display: inline;" 
                    onsubmit="return confirm('Are you sure you want to delete this file?')">
                <button type="submit"
                        class="text-gray-500 hover:text-red-600 transition-colors flex flex-col items-center text-xs">
                  <i class="ri-delete-bin-line text-2xl"></i>
                  <span>Delete</span>
                </button>
              </form>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="col-span-full flex flex-col items-center justify-center py-20 text-gray-400">
          <i class="ri-file-search-line text-6xl mb-4"></i>
          <p class="text-lg">No files uploaded yet.</p>
          <p class="text-sm mt-2">Upload your first file using the button above</p>
        </div>
      <% } %>
    </div>

    <!-- Upload Modal -->
    <div id="upload-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm">
      <div class="relative bg-white dark:bg-gray-800 rounded-2xl shadow-2xl p-6 w-full max-w-md mx-4">
        <button onclick="hideModal()" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 dark:hover:text-gray-200">
          <i class="ri-close-line text-2xl"></i>
        </button>

        <h3 class="text-xl font-semibold mb-6">Upload New File</h3>

        <form action="/upload" method="POST" enctype="multipart/form-data">
          <div class="flex items-center justify-center w-full">
            <label for="dropzone-file" 
                   class="flex flex-col items-center justify-center w-full h-64 border-2 border-dashed border-gray-300 dark:border-gray-600 rounded-xl cursor-pointer bg-gray-50 dark:bg-gray-700 hover:bg-gray-100 dark:hover:bg-gray-600 transition-all">
              <div class="flex flex-col items-center justify-center pt-5 pb-6">
                <i class="ri-upload-cloud-2-line text-5xl text-gray-400 mb-4"></i>
                <p class="mb-2 text-sm text-gray-500 dark:text-gray-400">
                  <span class="font-semibold">Click to upload</span> or drag and drop
                </p>
                <p class="text-xs text-gray-400">Max size: 50MB</p>
              </div>
              <input id="dropzone-file" name="file" type="file" class="hidden" onchange="this.form.submit()" />
            </label>
          </div>
        </form>

        <p class="mt-4 text-xs text-gray-400 text-center">
          Uploading will start automatically after selection.
        </p>
      </div>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/flowbite@4.0.1/dist/flowbite.min.js"></script>
  <script>
    const modal = document.getElementById('upload-modal');

    function showModal() {
      modal.classList.remove('hidden');
    }

    function hideModal() {
      modal.classList.add('hidden');
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') hideModal();
    });

    modal.addEventListener('click', (e) => {
      if (e.target === modal) hideModal();
    });
  </script>
</body>
</html>